@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_andueprober_needs_core FALSE)
if(NOT AndUEProber_FIND_COMPONENTS)
    set(_andueprober_needs_core TRUE)
endif()
foreach(_andueprober_component IN LISTS AndUEProber_FIND_COMPONENTS)
    if(_andueprober_component MATCHES "^(Core|Probe|ProcessMemory|Inspector|DumperAdapter)$")
        set(_andueprober_needs_core TRUE)
    endif()
endforeach()
if(_andueprober_needs_core)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/AndUEProberTargets.cmake")
    set(AndUEProber_Core_FOUND TRUE)
    set(AndUEProber_Probe_FOUND TRUE)
endif()
if("DumperAdapter" IN_LIST AndUEProber_FIND_COMPONENTS)
    set(AndUEProber_DumperAdapter_FOUND FALSE)
    if(@ANDUEPROBER_BUILD_DUMPER_ADAPTER@)
        include("${CMAKE_CURRENT_LIST_DIR}/AndUEProberDumperAdapterTargets.cmake")
        set(AndUEProber_DumperAdapter_FOUND TRUE)
    endif()
endif()
if("ProcessMemory" IN_LIST AndUEProber_FIND_COMPONENTS)
    set(AndUEProber_ProcessMemory_FOUND FALSE)
    if(@ANDUEPROBER_WITH_PROCESS_MEMORY@)
        if(NOT TARGET AndSwapChainHook::Memory)
            if(AndUEProber_FIND_REQUIRED_ProcessMemory)
                find_dependency(AndSwapChainHook 0.2 CONFIG COMPONENTS Memory)
            else()
                find_package(AndSwapChainHook 0.2 QUIET CONFIG COMPONENTS Memory)
            endif()
        endif()
        if(TARGET AndSwapChainHook::Memory)
            include("${CMAKE_CURRENT_LIST_DIR}/AndUEProberProcessMemoryTargets.cmake")
            set(AndUEProber_ProcessMemory_FOUND TRUE)
        endif()
    endif()
endif()
if("Agent" IN_LIST AndUEProber_FIND_COMPONENTS)
    set(AndUEProber_Agent_FOUND FALSE)
    if(@ANDUEPROBER_BUILD_AGENT@)
        include("${CMAKE_CURRENT_LIST_DIR}/AndUEProberAgentTargets.cmake")
        set(AndUEProber_Agent_FOUND TRUE)
    endif()
endif()
if("Inspector" IN_LIST AndUEProber_FIND_COMPONENTS)
    set(AndUEProber_Inspector_FOUND FALSE)
    if(@ANDUEPROBER_BUILD_INSPECTOR@)
        if(NOT TARGET AndUEProber::Inspector)
            set(_andueprober_imgui_target "")
            set(_andueprober_inspector_error "")
            if(ANDUEPROBER_IMGUI_TARGET)
                if(TARGET "${ANDUEPROBER_IMGUI_TARGET}")
                    set(_andueprober_imgui_target "${ANDUEPROBER_IMGUI_TARGET}")
                else()
                    set(_andueprober_inspector_error "ANDUEPROBER_IMGUI_TARGET must name an existing caller target")
                endif()
            elseif(@ANDUEPROBER_INSPECTOR_USE_DEFAULT_IMGUI@)
                if(AndUEProber_FIND_REQUIRED_Inspector)
                    find_dependency(AndUEProberImGui 1.92.2 EXACT CONFIG)
                else()
                    find_package(AndUEProberImGui 1.92.2 EXACT QUIET CONFIG)
                endif()
                if(TARGET AndUEProberImGui::Core)
                    set(_andueprober_imgui_target AndUEProberImGui::Core)
                else()
                    set(_andueprober_inspector_error "The default Inspector ImGui provider is unavailable")
                endif()
            else()
                set(_andueprober_inspector_error "This Inspector package requires an existing ANDUEPROBER_IMGUI_TARGET")
            endif()
            if(_andueprober_imgui_target)
                if(TARGET AndUEProberImGui::Binding)
                    get_target_property(_andueprober_imgui_binding AndUEProberImGui::Binding INTERFACE_LINK_LIBRARIES)
                    if(NOT _andueprober_imgui_binding STREQUAL _andueprober_imgui_target)
                        set(_andueprober_inspector_error "An incompatible ImGui binding already exists")
                    endif()
                else()
                    add_library(AndUEProberImGui::Binding INTERFACE IMPORTED)
                    set_target_properties(AndUEProberImGui::Binding PROPERTIES
                        INTERFACE_LINK_LIBRARIES "${_andueprober_imgui_target}"
                        INTERFACE_COMPILE_FEATURES cxx_std_20
                        INTERFACE_SOURCES "${CMAKE_CURRENT_LIST_DIR}/CheckImGuiVersion.cpp")
                endif()
                if(NOT _andueprober_inspector_error)
                    include("${CMAKE_CURRENT_LIST_DIR}/AndUEProberInspectorTargets.cmake")
                endif()
            endif()
            if(_andueprober_inspector_error AND AndUEProber_FIND_REQUIRED_Inspector)
                set(AndUEProber_FOUND FALSE)
                set(AndUEProber_NOT_FOUND_MESSAGE "${_andueprober_inspector_error}")
                return()
            endif()
        endif()
    endif()
    if(TARGET AndUEProber::Inspector)
        set(AndUEProber_Inspector_FOUND TRUE)
    endif()
endif()
check_required_components(AndUEProber)
